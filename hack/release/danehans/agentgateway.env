# The agentgateway source the chart's default gateway image is built from.
# A push that changes this file on a danehans/* branch of danehans/substrate
# runs .github/workflows/agentgateway-image.yaml for it. The chart default
# (images.agentgateway in charts/substrate/values.yaml) is then moved to the
# resulting digest in a separate, reviewed commit.
GATEWAY_REPOSITORY=danehans/agentgateway
GATEWAY_REVISION=259dca9667b775a143b4ee003a2b1b662ab37d2d
